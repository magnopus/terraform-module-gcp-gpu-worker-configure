# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# The project to configure. This module never creates it.
project_id = "your-project-id"

# The Magnopus identity that provisions and manages the GPU worker.
operator_members = [
  "serviceAccount:gpu-operator@artifacts-488618.iam.gserviceaccount.com",
]

# The VPC the worker attaches to. Required. Avoid the project's default VPC unless
# you have removed default-allow-ssh, which is open to the internet.
network = "your-vpc"

# Required: choose how the VM reaches the internet.
# true:  Cloud NAT in region, and the VM needs no external IP.
# false: no NAT, and the VM must be given an external IP.
enable_nat = true
region     = "us-west1"

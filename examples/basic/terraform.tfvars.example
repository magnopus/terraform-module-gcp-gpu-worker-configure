# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# The project to configure. This module never creates it.
project_id = "your-project-id"

# The Magnopus identity that provisions and manages the GPU worker.
operator_members = [
  "serviceAccount:gpu-operator@artifacts-488618.iam.gserviceaccount.com",
]

# Set true if the VM will have no external IP, and give it a region.
# Leave false if the VM gets an external IP.
enable_nat = false
region     = "us-west1"
